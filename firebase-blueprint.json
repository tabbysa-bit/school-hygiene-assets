{
  "entities": {
    "Material": {
      "title": "Material",
      "description": "Educational material item for monthly hygiene training or appendices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the material"
        },
        "type": {
          "type": "string",
          "enum": ["monthly", "appendix"],
          "description": "Type of educational material"
        },
        "month": {
          "type": "number",
          "description": "Month number (3, 4, 5, 6, 7, 9, 10, 11, 12, 2) if type is monthly"
        },
        "category": {
          "type": "string",
          "description": "Category key (foodborne, ccpcp) if type is appendix"
        },
        "page": {
          "type": "number",
          "description": "Page or sequence number"
        },
        "title": {
          "type": "string",
          "description": "Title of the educational material"
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle"
        },
        "imageUrl": {
          "type": "string",
          "description": "Web-optimized display image URL"
        },
        "imagePath": {
          "type": "string",
          "description": "Storage path for web-optimized image"
        },
        "originalImagePath": {
          "type": "string",
          "description": "Storage path for original image"
        },
        "originalImageUrl": {
          "type": "string",
          "description": "Storage download URL for original image"
        },
        "order": {
          "type": "number",
          "description": "Display order"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the material is published and visible to users"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["type", "title", "imageUrl", "order", "isPublished"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "User role"
        }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Collection of all monthly and appendix educational materials"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Collection of registered administrators"
    }
  }
}
